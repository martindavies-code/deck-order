# ==============================================================================
# DECK ORDER CONFIGURATION
# ==============================================================================

# Client Build-Time Configuration (Put these in client/.env for local development)
# In production on GitHub Pages, add them in GitHub repo Settings -> Secrets and variables -> Actions -> Variables
VITE_SPOTIFY_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Spotify Developer Dashboard Redirect URIs:
# Register BOTH exact strings with trailing slash at https://developer.spotify.com/dashboard:
# 1. https://martindavies-code.github.io/deck-order/   (Production on GitHub Pages)
# 2. http://127.0.0.1:5173/deck-order/                 (Local dev server - Spotify forbids localhost)
# (When testing locally, open your browser at http://127.0.0.1:5173/deck-order/)

# Google Cloud Console Authorized JavaScript Origins:
# Register at https://console.cloud.google.com/apis/credentials:
# 1. https://martindavies-code.github.io
# 2. http://127.0.0.1:5173

# ==============================================================================
# Optional Local Backend Proxy Server Configuration (node server/index.js)
# ==============================================================================
PORT=3001
CLIENT_ORIGIN=http://127.0.0.1:5173

# Optional: Server-side Spotify Client ID and Secret if using proxy mode
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/deck-order/

# External BPM & Key Providers (Never exposed to client)
# 1. GetSongBPM API (Free key at https://getsongbpm.com/api - ~3000 req/hr)
GETSONGBPM_API_KEY=

# 2. Sonovault (Free tier 1000 req/mo, no credit card at https://sonovault.now)
SONOVAULT_API_KEY=

# 3. SoundNet Track Analysis (RapidAPI) - Optional deeper analysis
# Free tier is only 5 req/day. Usable tiers start at USD 9.99/mo.
# DO NOT sign up unless you explicitly decide to pay.
SOUNDNET_API_KEY=

# Normalization parameters (default house/techno band)
BPM_MIN=90
BPM_MAX=180
