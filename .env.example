# Server configuration
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Spotify Web API Credentials (Development Mode)
# Create an app at https://developer.spotify.com/dashboard
# Add Redirect URI: http://localhost:5173/callback
SPOTIFY_CLIENT_ID=
# Optional Client Secret if proxying token exchanges (kept strictly server-side, NEVER exposed to client)
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:5173/callback

# Phase 1: External BPM & Key Providers (Never exposed to client)
# 1. GetSongBPM API (Free key at https://getsongbpm.com/api - ~3000 req/hr)
GETSONGBPM_API_KEY=

# 2. Sonovault (Free tier 1000 req/mo, no credit card at https://sonovault.now)
SONOVAULT_API_KEY=

# 3. SoundNet Track Analysis (RapidAPI) - Optional deeper analysis
# Free tier is only 5 req/day. Usable tiers start at USD 9.99/mo.
# DO NOT sign up unless you explicitly decide to pay.
SOUNDNET_API_KEY=

# Normalization parameters (default house/techno band)
BPM_MIN=90
BPM_MAX=180
